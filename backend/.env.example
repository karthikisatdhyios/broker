# ===== Server =====
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (for local dev).
# In a single-project Vercel deploy the frontend and API share an origin,
# so CORS is effectively same-origin in production.
CLIENT_ORIGIN=http://localhost:5173

# ===== Database (MongoDB-compatible) =====
# For "everything AWS", use Amazon DocumentDB.
# Example DocumentDB URI:
# mongodb://USER:PASS@your-docdb.cluster-xxxx.ap-south-1.docdb.amazonaws.com:27017/?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
# MongoDB Atlas also works with the same code if you prefer the free tier.
MONGODB_URI=
# Database name to use inside the cluster.
MONGODB_DB=broker_collab

# ===== Auth =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Business rules =====
PROPERTY_EXPIRY_HOURS=48
LEAD_EXPIRY_DAYS=21
LEASE_DURATION_MONTHS=11
RENEWAL_WINDOW_DAYS=30
FREE_TIER_PROPERTY_LIMIT=5

# ===== Geocoding =====
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GOOGLE_GEOCODING_API_KEY=

# ===== Image upload (AWS S3) =====
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional: set this if you serve S3 through CloudFront or a custom domain.
# Example: https://cdn.example.com
AWS_S3_PUBLIC_BASE_URL=

# ===== Cron =====
# Local/AWS long-running server uses node-cron automatically.
# Optional: protects GET /api/cron if you trigger jobs manually.
CRON_SECRET=
