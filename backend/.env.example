# ===== Server =====
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins.
# In production set this to your Vercel URL, e.g. https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ===== Database =====
# Data is stored in plain JSON files under backend/data/ (NeDB).
# No database server required. Override the folder with:
# DATA_DIR=/path/to/data
# In production point this at a persistent disk, e.g. /var/data/db
DATA_DIR=

# ===== Auth =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== Business rules =====
PROPERTY_EXPIRY_HOURS=48
LEAD_EXPIRY_DAYS=21
LEASE_DURATION_MONTHS=11
RENEWAL_WINDOW_DAYS=30
FREE_TIER_PROPERTY_LIMIT=5

# ===== Geocoding =====
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GOOGLE_GEOCODING_API_KEY=

# ===== Image upload =====
UPLOAD_DRIVER=local
# Folder for uploaded images. In production point this at a persistent disk,
# e.g. /var/data/uploads (otherwise uploads are lost on restart/redeploy).
UPLOAD_DIR=
